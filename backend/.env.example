PORT=4000

# PostgreSQL connection string
# Local dev example: postgresql://localhost:5432/YOUR_DB_NAME
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/YOUR_DB_NAME

# Set to false for local Postgres (no SSL). Omit or set to anything else
# for hosted providers (Neon, Supabase, Render, RDS) — SSL will be used
# and the server's certificate will be properly verified.
PGSSL=false

# Use a long, random string in production (e.g. `openssl rand -hex 64`)
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Default expiry for share tokens, in minutes
SHARE_TOKEN_DEFAULT_TTL_MINUTES=60