# ============================================================================
# MedRec Backend Environment Configuration (PostgreSQL + Cloudflare R2)
# ============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development

# PostgreSQL Connection String (Direct PostgreSQL Database)
# Examples:
# Local PostgreSQL: postgresql://postgres:password@localhost:5432/medrec
# Neon / Render / AWS RDS: postgresql://username:password@hostname:5432/database?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/medrec

# PostgreSQL SSL Mode
# Set to 'false' for local PostgreSQL development; 'true' for managed cloud PostgreSQL
PGSSL=false
PGSSL_REJECT_UNAUTHORIZED=false

# JSON Web Token Secret (Backend-Owned Authentication)
# Must be a cryptographically secure random string with at least 32 characters
JWT_SECRET=medrec_super_secure_jwt_secret_at_least_32_characters_long_for_signing
JWT_EXPIRES_IN=7d

# Cloudflare R2 Object Storage Configuration (S3-Compatible)
# Obtain from Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_api_token_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_api_token_secret_access_key
R2_BUCKET_NAME=medrec-vault
# R2 Endpoint format: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com

# Doctor Share QR Code Default Expiry (Minutes)
SHARE_TOKEN_DEFAULT_TTL_MINUTES=60

# OpenAI Configuration (Preserved for Future AI Milestone)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Google OAuth 2.0 Web Client ID (Audience Verification)
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
