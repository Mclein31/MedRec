{
  "expo": {
    "name": "MedRec",
    "slug": "medrec",
    "version": "2.0.0",
    "scheme": "medrec",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.mclein.medrec",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "MedRec uses the camera to photograph medical documents you choose to add.",
        "NSPhotoLibraryUsageDescription": "MedRec lets you add photos of medical documents from your library.",
        "NSFaceIDUsageDescription": "MedRec uses Face ID to unlock your health records."
      }
    },
    "android": {
      "package": "com.mclein.medrec",
      "adaptiveIcon": {
        "backgroundImage": "./assets/images/android-icon-background.png",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/DMSans_400Regular.ttf",
            "./assets/fonts/DMSans_500Medium.ttf",
            "./assets/fonts/DMSans_600SemiBold.ttf",
            "./assets/fonts/DMSans_700Bold.ttf",
            "./assets/fonts/Sora_600SemiBold.ttf",
            "./assets/fonts/Sora_700Bold.ttf",
            "./assets/fonts/Manrope_800ExtraBold.ttf"
          ]
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "MedRec uses Face ID to unlock your health records."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "MedRec uses the camera to photograph medical documents you choose to add.",
          "photosPermission": "MedRec lets you add photos of medical documents from your library."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-remy.png",
          "imageWidth": 180,
          "backgroundColor": "#492D48",
          "dark": {
            "backgroundColor": "#492D48"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
