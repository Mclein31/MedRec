# MedRec v2 — production configuration. One file for the API, database setup and app.
# Copy to apps/.env (gitignored), fill in, then from apps/api:
#   npm run migrate:prod   once, and after schema changes (uses the Neon owner login)
#   npm run deploy:prod    deploys the Worker and uploads its secrets
# Values are checked before anything is sent. Local development uses apps/api/.dev.vars instead.

# ── URLs ─────────────────────────────────────────────────────────────
# Your Worker's address (shown after the first deploy), e.g. https://medrec-api.<subdomain>.workers.dev
PUBLIC_URL=
# Optional. Only if you publish the web version of the app: its origin(s), comma-separated.
ALLOWED_ORIGINS=
# What the app calls. Normally the same as PUBLIC_URL. Only EXPO_PUBLIC_* values reach the app.
EXPO_PUBLIC_API_URL=

# ── Database: Neon ───────────────────────────────────────────────────
# Owner connection, DIRECT (non-pooled) host. Used only by migrate:prod, never uploaded.
MIGRATION_DATABASE_URL=
# A new password for the medrec_app role (openssl rand -hex 16). migrate:prod sets it.
APP_DB_PASSWORD=
# POOLED host, user medrec_app, password = APP_DB_PASSWORD:
# postgresql://medrec_app:<APP_DB_PASSWORD>@ep-xxxx-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL=

# ── Signing keys ─────────────────────────────────────────────────────
# Two different random values: openssl rand -hex 32
JWT_SECRET=
FILE_SIGNING_SECRET=

# ── AI: Google Gemini ────────────────────────────────────────────────
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Email codes: Gmail ───────────────────────────────────────────────
# Sending Gmail address, and its 16-letter App Password
# (Google Account → Security → 2-Step Verification → App passwords)
SMTP_USER=
SMTP_PASSWORD=
