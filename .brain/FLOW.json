  },
  {
   "id": "dec.file",
   "label": "File link valid?",
   "kind": "decision",
   "layer": "backend",
   "detail": "Signed file URLs are served only while the signature and expiry verify (403 LINK_EXPIRED otherwise).",
   "file": "apps/api/src/routes/public.tsx"
  }
