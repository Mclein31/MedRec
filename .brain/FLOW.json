   "file": "apps/mobile/src/medications/notifications.ts"
  },
  {
   "id": "dec.share",
   "label": "Share link active?",
   "kind": "decision",
   "layer": "backend",
   "detail": "openShare returns a share only if the token is valid and not expired or revoked; otherwise the unavailable page (404).",
