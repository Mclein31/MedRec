# ============================================================================
# MedRec Mobile Client Environment Configuration
# ============================================================================

# Leave blank in development: use Metro's current host with API port 4000.
# This follows Wi-Fi IP changes and supports the simulator, emulator, and web.
# Set an explicit URL for a separate backend or production deployment.
# Example deployment: https://api.example.com/api
EXPO_PUBLIC_API_URL=

# Google OAuth 2.0 Client IDs
# Web Client ID (passed as webClientId to mint idToken with matching audience)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# iOS Client ID (optional on native iOS when webClientId is provided)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com
